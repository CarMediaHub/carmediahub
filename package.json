{
  "name": "@carmediahub/core",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Core and single gateway for CarMediaHub.",
  "license": "AGPL-3.0-only",
  "carmediahub": {
    "databaseSchemaVersion": 1
  },
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/cli.ts -- --data-dir ./data",
    "start": "tsx src/cli.ts",
    "backup": "node dist/backup-cli.js",
    "sbom": "node scripts/generate-sbom.mjs",
    "upgrade-preflight": "node scripts/upgrade-preflight.mjs",
    "component:prepare-release": "node scripts/prepare-component-release.mjs",
    "component:sign-release": "node scripts/sign-component-release.mjs",
    "component:assemble-matrix": "node scripts/assemble-component-release-matrix.mjs",
    "native-install-plan": "node scripts/native-install-plan.mjs",
    "native-install-preview": "node scripts/native-install-preview.mjs",
    "test:native-install-actions": "node --test scripts/native-install-actions.test.mjs",
    "test:native-install-executor": "node --test scripts/native-install-executor.test.mjs",
    "test:native-install-preview": "node --test scripts/native-install-preview.test.mjs",
    "native-install-apply": "node scripts/native-install-apply.mjs",
    "test:native-install-apply": "node --test scripts/native-install-apply.test.mjs",
    "build": "tsc -p tsconfig.json",
    "build:admin": "cd admin && pnpm install --ignore-workspace --frozen-lockfile --ignore-scripts && pnpm build && cd .. && node scripts/copy-admin.mjs",
    "check:deployment": "node scripts/validate-deployment.mjs",
    "test:deployment": "node --test scripts/validate-deployment.test.mjs",
    "check:native-bundle": "node scripts/validate-native-bundle.mjs",
    "check:resources": "node scripts/preflight-resources.mjs",
    "create:native-bundle": "node scripts/create-native-bundle.mjs",
    "test:create-native-bundle": "node --test scripts/create-native-bundle.test.mjs",
    "test:native-recovery": "node --test scripts/native-recovery-smoke.test.mjs",
    "test:resources": "node --test scripts/preflight-resources.test.mjs",
    "test:upgrade": "node --test --import tsx src/upgrade-preflight.test.ts",
    "test:component-release": "node --test scripts/prepare-component-release.test.mjs",
    "test:component-release-matrix": "node --test scripts/validate-component-release-matrix.test.mjs",
    "test:component-signing": "node --test scripts/sign-component-release.test.mjs",
    "test:component-matrix-assembly": "node --test scripts/assemble-component-release-matrix.test.mjs",
    "test:postgres": "node scripts/postgres-smoke.mjs",
    "test:mysql": "node --import tsx --test src/mysql-data-service.test.ts",
    "test:mysql:service": "node scripts/mysql-smoke.mjs",
    "test:native-install-plan": "node --test scripts/native-install-plan.test.mjs",
    "test:native-bundle": "node --test scripts/validate-native-bundle.test.mjs",
    "test:native-service": "node --test scripts/native-windows-service.test.mjs",
    "test:native-linux-service": "node --test scripts/native-linux-service.test.mjs",
    "smoke:browser": "tsx scripts/browser-worker-smoke.ts",
    "smoke:admin": "tsx scripts/admin-browser-smoke.ts",
    "smoke:wdr-ui": "tsx scripts/wdr-ui-smoke.ts",
    "smoke:media-http": "tsx scripts/media-http-smoke.ts",
    "smoke:startup": "node scripts/core-startup-smoke.mjs",
    "smoke:native-recovery": "node scripts/native-recovery-smoke.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm check:deployment && pnpm test:deployment && pnpm check && pnpm --dir admin check && pnpm test && pnpm build && pnpm build:admin && pnpm smoke:startup && pnpm test:upgrade && pnpm test:component-release && pnpm test:component-release-matrix && pnpm test:component-signing && pnpm test:component-matrix-assembly && pnpm test:native-bundle && pnpm test:create-native-bundle && pnpm test:native-recovery && pnpm test:resources && pnpm test:native-service && pnpm test:native-linux-service && pnpm test:native-install-actions && pnpm test:native-install-executor && pnpm test:native-install-preview && pnpm test:native-install-apply && pnpm test:native-install-plan && pnpm test:mysql",
    "test": "tsx --test --test-concurrency=1 src/**/*.test.ts",
    "test:coverage": "tsx --test --test-concurrency=1 --experimental-test-coverage src/**/*.test.ts"
  },
  "dependencies": {
    "@carmediahub/sdk": "file:../carmediahub-sdk",
    "@fastify/cookie": "^11.0.2",
    "fastify": "^5.2.1",
    "mysql2": "3.14.1",
    "pg": "^8.23.0",
    "playwright-core": "1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
