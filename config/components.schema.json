{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "displayName", "kind", "provides", "version", "executable", "platforms", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "displayName": { "type": "string" },
          "kind": { "enum": ["service", "media-tool", "utility", "network-service"] },
          "provides": { "type": "array", "items": { "enum": ["storage-service", "webdav", "media-processing", "archive", "network-egress", "browser-engine"] }, "minItems": 1, "uniqueItems": true },
          "version": { "type": "string" },
          "executable": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\]+$" },
          "platforms": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "sha256": { "type": ["string", "null"] },
          "status": { "enum": ["catalog-only", "installed", "unhealthy", "disabled"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
