{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carmediahub.github.io/schemas/native-install-plan.schema.json",
  "title": "CarMediaHub Native installation plan",
  "description": "Machine-readable dry-run plan. It describes intended actions and never authorizes their execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform", "bundle", "resources", "service", "serviceAccount", "acl", "actions"],
  "properties": {
    "platform": { "enum": ["windows", "linux"] },
    "bundle": { "$ref": "#/$defs/bundle" },
    "resources": { "$ref": "#/$defs/resources" },
    "service": { "type": "object", "additionalProperties": true },
    "serviceAccount": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\r\\n]+$" },
    "acl": { "type": "array", "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["path", "access"], "properties": { "path": { "type": "string", "minLength": 1 }, "access": { "enum": ["read-execute", "read-only", "read-write"] } } } },
    "actions": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/action" } }
  },
  "$defs": {
    "bundle": { "type": "object", "additionalProperties": false, "required": ["files", "packageVersion", "databaseSchemaVersion"], "properties": { "files": { "type": "integer", "minimum": 1 }, "packageVersion": { "type": "string", "minLength": 1 }, "databaseSchemaVersion": { "type": "integer", "minimum": 1 } } },
    "resources": { "type": "object", "additionalProperties": false, "required": ["bundleRoot", "configPath", "dataDir", "freeBytes", "requiredFreeBytes"], "properties": { "bundleRoot": { "type": "string", "minLength": 1 }, "configPath": { "type": "string", "minLength": 1 }, "dataDir": { "type": "string", "minLength": 1 }, "freeBytes": { "type": "integer", "minimum": 0 }, "requiredFreeBytes": { "type": "integer", "minimum": 0 } } },
    "action": { "type": "object", "additionalProperties": false, "required": ["command", "args", "description", "idempotency"], "properties": { "command": { "type": "string", "enum": ["icacls.exe", "sc.exe", "useradd", "install", "chown", "systemctl"] }, "args": { "type": "array", "items": { "type": "string", "pattern": "^[^\\u0000\\r\\n]*$" } }, "description": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$" }, "stdin": { "type": "string", "pattern": "^[^\\u0000]*$" }, "idempotency": { "enum": ["repeatable", "ensure"] } } }
  }
}
